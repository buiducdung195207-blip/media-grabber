{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/download/route.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "src/app/api/info/route.ts": {
      "maxDuration": 30,
      "memory": 256
    },
    "src/app/api/platforms/route.ts": {
      "maxDuration": 10,
      "memory": 128
    },
    "src/app/api/health/route.ts": {
      "maxDuration": 5,
      "memory": 128
    }
  },
  "env": {
    "COBALT_API_URL": "@cobalt_api_url"
  }
}
